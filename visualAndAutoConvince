
-- Steal a Brainrot Transfer Helper
-- Target: TxCLuke
-- User ID: 9303869889
-- Mobile-friendly checklist UI

local Players = game:GetService("Players")
local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "TransferHelper"
gui.ResetOnSpawn = false

pcall(function()
    gui.Parent = game:GetService("CoreGui")
end)

if not gui.Parent then
    gui.Parent = player:WaitForChild("PlayerGui")
end

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 270, 0, 310)
frame.Position = UDim2.new(0.5, -135, 0.35, 0)
frame.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
frame.BorderSizePixel = 0
frame.Active = true
frame.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = frame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -40, 0, 40)
title.Position = UDim2.new(0, 10, 0, 5)
title.BackgroundTransparency = 1
title.Text = "Transfer Helper"
title.TextColor3 = Color3.new(1, 1, 1)
title.TextScaled = true
title.Font = Enum.Font.GothamBold
title.Parent = frame

local close = Instance.new("TextButton")
close.Size = UDim2.new(0, 30, 0, 30)
close.Position = UDim2.new(1, -35, 0, 5)
close.Text = "X"
close.TextColor3 = Color3.new(1, 1, 1)
close.BackgroundColor3 = Color3.fromRGB(170, 50, 50)
close.Parent = frame

close.MouseButton1Click:Connect(function()
    gui:Destroy()
end)

local target = Instance.new("TextLabel")
target.Size = UDim2.new(1, -20, 0, 45)
target.Position = UDim2.new(0, 10, 0, 50)
target.BackgroundTransparency = 1
target.Text = "Target: TxCLuke\nID: 9303869889"
target.TextColor3 = Color3.fromRGB(180, 220, 255)
target.TextScaled = true
target.Font = Enum.Font.Gotham
target.Parent = frame

local categories = {
    "Brainrots",
    "Gear",
    "Bases / Upgrades",
    "Skins / Cosmetics"
}

local selected = {}

for i, category in ipairs(categories) do
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -30, 0, 35)
    button.Position = UDim2.new(0, 15, 0, 105 + (i - 1) * 42)
    button.BackgroundColor3 = Color3.fromRGB(65, 65, 85)
    button.TextColor3 = Color3.new(1, 1, 1)
    button.TextScaled = true
    button.Font = Enum.Font.Gotham
    button.Text = "[ ] " .. category
    button.Parent = frame

    selected[category] = false

    button.MouseButton1Click:Connect(function()
        selected[category] = not selected[category]
        button.Text = (selected[category] and "[X] " or "[ ] ")
            .. category
        button.BackgroundColor3 = selected[category]
            and Color3.fromRGB(35, 125, 85)
            or Color3.fromRGB(65, 65, 85)
    end)
end

local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, -20, 0, 30)
status.Position = UDim2.new(0, 10, 1, -38)
status.BackgroundTransparency = 1
status.Text = "Select categories to transfer"
status.TextColor3 = Color3.new(1, 1, 1)
status.TextScaled = true
status.Font = Enum.Font.Gotham
status.Parent = frame

local review = Instance.new("TextButton")
review.Size = UDim2.new(0, 100, 0, 30)
review.Position = UDim2.new(1, -110, 1, -75)
review.BackgroundColor3 = Color3.fromRGB(60, 110, 190)
review.Text = "Review"
review.TextColor3 = Color3.new(1, 1, 1)
review.TextScaled = true
review.Parent = frame

review.MouseButton1Click:Connect(function()
    local list = {}

    for category, enabled in pairs(selected) do
        if enabled then
            table.insert(list, category)
        end
    end

    if #list == 0 then
        status.Text = "Select a category first!"
    else
        status.Text = "Selected: " .. table.concat(list, ", ")
        print("Transfer target: TxCLuke (9303869889)")
        print("Selected categories: " .. table.concat(list, ", "))
        print("Add eligible items through the official trade UI.")
    end
end)

print("Transfer Helper loaded for TxCLuke.")
